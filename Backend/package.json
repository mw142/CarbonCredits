{
  "name": "renewco-platform-backend",
  "version": "2.0.0",
  "description": "renewCo. carbon marketplace API and SQLite database (powered by IrongateIT)",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "dev": "node --experimental-sqlite --watch server.js",
    "check": "node --experimental-sqlite check-schema.js",
