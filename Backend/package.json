    "create-admin": "node --experimental-sqlite create-admin.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "express": "^4.19.2",
    "groq-sdk": "^1.6.0",
    "jsonwebtoken": "^9.0.2"
  }
}
