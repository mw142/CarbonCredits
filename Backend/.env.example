# Copy to Backend/.env and fill in your key from https://console.groq.com/keys

# Groq-powered chatbot
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional
# PORT=4000
# JWT_SECRET=change-me-to-a-long-random-string
# CER_REGISTER_CSV_URL=   (default source for Admin → Integrations → scheduled pull)
# SCHEDULER_TICK_MS=600000
